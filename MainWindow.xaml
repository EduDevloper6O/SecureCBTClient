<Window x:Class="SecureCBTClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure CBT - Candidate Login" Height="550" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI">

    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <!-- Header Icon & Title -->
            <Border Background="#E0F2FE" Width="70" Height="70" CornerRadius="35" HorizontalAlignment="Center" Margin="0,0,0,15">
                <TextBlock Text="🔒" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="CBT Examination Portal" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
            <TextBlock Text="Sign in to start your examination" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,25"/>

            <!-- Roll Number -->
            <TextBlock Text="ROLL NUMBER" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtRollNumber" Height="40" Padding="10,0" FontSize="14" VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" Margin="0,0,0,15"/>

            <!-- PIN / Password -->
            <TextBlock Text="EXAM PIN / PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="40" Padding="10,0" FontSize="14" VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" Margin="0,0,0,15"/>

            <!-- Exam Code -->
            <TextBlock Text="EXAM CODE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtExamCode" Height="40" Padding="10,0" FontSize="14" CharacterCasing="Upper" VerticalContentAlignment="Center" Background="White" BorderBrush="#CBD5E1" Margin="0,0,20"/>

            <!-- Login Button -->
            <Button x:Name="btnLogin" Content="LOGIN TO EXAM" Height="45" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="btnLogin_Click"/>

            <TextBlock x:Name="lblStatus" Text="" Foreground="#DC2626" FontSize="12" TextAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>