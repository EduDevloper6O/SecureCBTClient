<Window x:Class="SecureCBTClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure CBT - Candidate Access" Height="700" Width="1040"
        MinHeight="650" MinWidth="960" WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" Background="#EDF2F6"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="LoginFieldStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D5DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,6,0,17"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2457A7"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2457A7"/>
            <Setter Property="BorderBrush" Value="#2457A7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="18,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#1D4789"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#93A2B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainContainer" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                    <ThicknessAnimation Storyboard.TargetName="FormPanel" Storyboard.TargetProperty="Margin" From="42,34,42,34" To="42,24,42,24" Duration="0:0:0.4">
                        <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="MainContainer" Margin="18" Opacity="1">
        <Border Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Color="#152B43" Opacity="0.13"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#14283F">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="30,30,24,0">
                            <Border Width="42" Height="42" CornerRadius="7" Background="#FFFFFF" Margin="0,0,12,0">
                                <TextBlock Text="CBT" FontSize="13" FontWeight="Bold" Foreground="#2457A7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SECURE CBT" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="EXAMINATION CLIENT" FontSize="9" FontWeight="SemiBold" Foreground="#AAB8C8" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="34,18,28,18">
                            <TextBlock Text="Candidate portal" FontSize="26" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                            <TextBlock Text="Use the credentials issued by your examination authority to open your assigned test." FontSize="14" Foreground="#C5D0DD" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,30"/>

                            <Border Height="1" Background="#3B4C60" Margin="0,0,0,24"/>
                            <TextBlock Text="EXAM SESSION FLOW" FontSize="10" FontWeight="Bold" Foreground="#AAB8C8" Margin="0,0,0,18"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#DDE8F5">
                                    <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#14283F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Candidate access" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#2A4058">
                                    <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#CFD9E4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Instructions and readiness" FontSize="13" Foreground="#C5D0DD" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="13" Background="#2A4058">
                                    <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#CFD9E4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Timed examination" FontSize="13" Foreground="#C5D0DD" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="For authorized candidates only" FontSize="11" Foreground="#AAB8C8" Margin="30,0,20,24"/>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="#FFFFFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="38,25,30,0" LastChildFill="False">
                        <TextBlock Text="CANDIDATE ACCESS" FontSize="10" FontWeight="Bold" Foreground="#617188" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button x:Name="btnClose" Content="Close" Width="62" Height="30" Background="#FFFFFF" Foreground="#617188" BorderBrush="#D8E1EB" FontSize="11" Click="btnClose_Click" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <StackPanel x:Name="FormPanel" Grid.Row="1" VerticalAlignment="Center" Margin="42,24,42,24">
                        <TextBlock Text="Sign in to your exam" FontSize="25" FontWeight="SemiBold" Foreground="#17283D"/>
                        <TextBlock Text="Enter the details provided on your candidate admit card." FontSize="13" Foreground="#617188" Margin="0,7,0,26"/>

                        <TextBlock Text="Roll number" FontSize="12" FontWeight="SemiBold" Foreground="#34465B"/>
                        <Border Style="{StaticResource LoginFieldStyle}">
                            <TextBox x:Name="txtRollNumber" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" Foreground="#17283D" Padding="14,0" AutomationProperties.Name="Roll number"/>
                        </Border>

                        <TextBlock Text="Password or secure PIN" FontSize="12" FontWeight="SemiBold" Foreground="#34465B"/>
                        <Border Style="{StaticResource LoginFieldStyle}">
                            <PasswordBox x:Name="txtPassword" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" Foreground="#17283D" Padding="14,0" AutomationProperties.Name="Password or secure PIN"/>
                        </Border>

                        <TextBlock Text="Exam code" FontSize="12" FontWeight="SemiBold" Foreground="#34465B"/>
                        <Border Style="{StaticResource LoginFieldStyle}" Margin="0,6,0,22">
                            <TextBox x:Name="txtExamCode" CharacterCasing="Upper" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" Foreground="#17283D" Padding="14,0" AutomationProperties.Name="Exam code"/>
                        </Border>

                        <Button x:Name="btnLogin" Content="Continue to instructions" Height="48" Style="{StaticResource LoginPrimaryButtonStyle}" Click="btnLogin_Click"/>
                        <TextBlock x:Name="lblStatus" Text="" Foreground="#B42318" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="18"/>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="#E7EDF3" BorderThickness="0,1,0,0" Background="#F8FAFC" Padding="38,13">
                        <TextBlock Text="Your exam session starts after candidate credentials are authenticated." FontSize="11" Foreground="#617188" TextWrapping="Wrap"/>
                    </Border>

                    <Grid x:Name="OverlayLoading" Background="#F2FFFFFF" Visibility="Collapsed" Panel.ZIndex="10">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Ellipse Width="42" Height="42" Canvas.Left="3" Canvas.Top="3" Stroke="#DCE5EF" StrokeThickness="4"/>
                                <Path Data="M 24 4 A 20 20 0 0 1 44 24" Stroke="#2457A7" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.RenderTransform><RotateTransform x:Name="SpinnerTransform" CenterX="24" CenterY="24"/></Path.RenderTransform>
                                </Path>
                            </Canvas>
                            <TextBlock Text="Checking candidate access" FontSize="15" FontWeight="SemiBold" Foreground="#17283D" HorizontalAlignment="Center"/>
                            <TextBlock Text="Connecting to the examination service" FontSize="12" Foreground="#617188" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
