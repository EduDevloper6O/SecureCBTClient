<Window x:Class="SecureCBTClient.ExamDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CBT Exam Dashboard" WindowState="Maximized" WindowStyle="None" 
        Topmost="True" ResizeMode="NoResize"
        Background="#E5E7EB" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="COMPUTER BASED TEST (CBT)" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="#0F172A" Padding="15,5" VerticalAlignment="Center" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Time Left: " FontSize="16" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="lblTimer" Text="00:00:00" Foreground="#F87171" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,5,0"/>
                    <TextBlock x:Name="lblSyncStatus" Text="Connected to Server" Foreground="#94A3B8" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.5*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: QUESTION AREA -->
            <Grid Grid.Column="0" Background="White" Margin="10,10,5,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SECTION TABS -->
                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="spSectionTabs" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Border>

                <!-- QUESTION HEADER -->
                <Grid Grid.Row="1" Margin="20,15,20,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="lblQuestionNumber" Grid.Column="0" Text="Question No. 1" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="View In: " VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,5,0" FontSize="13"/>
                        <ComboBox x:Name="cmbLanguage" Width="100" SelectedIndex="0" Height="26" VerticalAlignment="Center" FontSize="13" SelectionChanged="cmbLanguage_SelectionChanged">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Hindi"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" VerticalAlignment="Bottom" Background="#E2E8F0"/>

                <!-- QUESTION CONTENT & OPTIONS -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,10,20,20">
                    <StackPanel>
                        <TextBlock x:Name="txtQuestion" Text="Loading question data..." FontSize="16" TextWrapping="Wrap" Foreground="#0F172A" Margin="0,10,0,15" LineHeight="24"/>

                        <!-- QUESTION IMAGE FROM GOOGLE DRIVE -->
                        <Border x:Name="borderQuestionImg" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,0,0,20" HorizontalAlignment="Left" MaxHeight="300" Visibility="Collapsed">
                            <Image x:Name="imgQuestionPhoto" Stretch="Uniform" HorizontalAlignment="Left"/>
                        </Border>

                        <!-- OPTIONS -->
                        <RadioButton x:Name="optA" GroupName="Answers" Margin="0,0,0,15" Checked="Option_Checked" Tag="A">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="1." FontWeight="Bold" FontSize="15" Margin="0,0,10,0" Foreground="#334155"/>
                                <TextBlock x:Name="txtOptA" Text="Option A" FontSize="15" TextWrapping="Wrap" Foreground="#334155"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="optB" GroupName="Answers" Margin="0,0,0,15" Checked="Option_Checked" Tag="B">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="2." FontWeight="Bold" FontSize="15" Margin="0,0,10,0" Foreground="#334155"/>
                                <TextBlock x:Name="txtOptB" Text="Option B" FontSize="15" TextWrapping="Wrap" Foreground="#334155"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="optC" GroupName="Answers" Margin="0,0,0,15" Checked="Option_Checked" Tag="C">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="3." FontWeight="Bold" FontSize="15" Margin="0,0,10,0" Foreground="#334155"/>
                                <TextBlock x:Name="txtOptC" Text="Option C" FontSize="15" TextWrapping="Wrap" Foreground="#334155"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="optD" GroupName="Answers" Margin="0,0,0,15" Checked="Option_Checked" Tag="D">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="4." FontWeight="Bold" FontSize="15" Margin="0,0,10,0" Foreground="#334155"/>
                                <TextBlock x:Name="txtOptD" Text="Option D" FontSize="15" TextWrapping="Wrap" Foreground="#334155"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT: PROFILE & PALETTE -->
            <Grid Grid.Column="1" Background="#F8FAFC" Margin="5,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CANDIDATE DETAILS -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#E2E8F0" Width="50" Height="60" BorderThickness="1" BorderBrush="#CBD5E1">
                            <Image x:Name="imgCandidatePhoto" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblCandidateName" Text="Candidate Name" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock x:Name="lblRollExam" Text="Roll No: 123456789" FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PALETTE LEGEND -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#10B981"/>
                            <TextBlock Text="Answered" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#EF4444"/>
                            <TextBlock Text="Not Answered" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1"/>
                            <TextBlock Text="Not Visited" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="12" Background="#8B5CF6"/>
                            <TextBlock Text="Marked" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PALETTE GRID -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Current Section Palette" FontWeight="SemiBold" Foreground="#334155" Margin="5,0,0,10" Background="#F1F5F9" Padding="5" FontSize="13"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="wpPalette" HorizontalAlignment="Left" Margin="5"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- BOTTOM CONTROLS -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnReview" Grid.Column="0" Content="Mark for Review &amp; Next" Height="36" Width="180" Margin="0,0,10,0" Background="#F59E0B" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                <Button x:Name="btnClear" Grid.Column="1" Content="Clear Response" Height="36" Width="130" Background="#F1F5F9" Foreground="#475569" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Click="btnClear_Click" FontSize="13" VerticalAlignment="Center"/>
                <Button x:Name="btnPrev" Grid.Column="3" Content="Previous" Height="36" Width="100" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#1E293B" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="btnPrev_Click" FontSize="13" VerticalAlignment="Center"/>
                <Button x:Name="btnNext" Grid.Column="4" Content="Save &amp; Next" Height="36" Width="120" Margin="0,0,20,0" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnNext_Click" FontSize="13" VerticalAlignment="Center"/>
                <Button x:Name="btnSubmitExam" Grid.Column="5" Content="Submit Exam" Height="36" Width="120" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnSubmitExam_Click" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- LOADING OVERLAY -->
        <Grid x:Name="gridLoading" Grid.RowSpan="3" Background="#CC1E293B" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock x:Name="txtLoadingMessage" Text="Connecting to Secure Server..." FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Downloading encrypted section sheets &amp; media..." FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>