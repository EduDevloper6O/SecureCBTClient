<Window x:Class="SecureCBTClient.ExamDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CBT Exam Dashboard" WindowState="Maximized" WindowStyle="None"
        Topmost="True" ResizeMode="NoResize" Background="#F2F5F9" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnswerOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="#263A50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="AnswerSurface" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="6" Padding="15,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Ellipse Stroke="#8292A5" StrokeThickness="1.5" Fill="#FFFFFF"/>
                                    <Ellipse x:Name="CheckMark" Margin="4" Fill="#2457A7" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AnswerSurface" Property="BorderBrush" Value="#9EB4CC"/>
                                <Setter TargetName="AnswerSurface" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AnswerSurface" Property="BorderBrush" Value="#2457A7"/>
                                <Setter TargetName="AnswerSurface" Property="Background" Value="#EFF5FC"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="AnswerSurface" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="78"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#14283F" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="5" Background="#FFFFFF" VerticalAlignment="Center">
                    <Image x:Name="imgAuthorityLogo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" Margin="4"/>
                </Border>
                <StackPanel x:Name="HeaderTextPanel" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
                    <TextBlock x:Name="lblAuthorityName" Text="EXAMINATION AUTHORITY" Foreground="#D5DFE9" Opacity="0.95" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="lblExamTitle" Text="EXAMINATION TITLE" Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <Border x:Name="TimerBorder" Grid.Column="2" Background="#1B3049" BorderBrush="#486078" BorderThickness="1" Padding="16,7" Margin="0,0,12,0" VerticalAlignment="Center" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="TIME REMAINING" FontSize="9" FontWeight="Bold" Foreground="#DBE4ED" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock x:Name="lblTimer" Text="00:00:00" Foreground="#FFFFFF" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#243A52" BorderBrush="#40566D" BorderThickness="1" Padding="13,10" CornerRadius="5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#AAB7C5" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblSyncStatus" Text="Sync pending" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.05*" MinWidth="310"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="7" Margin="0,0,18,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F7F9FC" BorderBrush="#D8E1EB" BorderThickness="0,0,0,1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="spSectionTabs" Orientation="Horizontal" Margin="12,8,12,0"/>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="1" Margin="26,20,26,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CURRENT QUESTION" FontSize="9" FontWeight="Bold" Foreground="#617188" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblQuestionNumber" Text="Question No. 1" FontSize="19" FontWeight="SemiBold" Foreground="#17283D"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Language" VerticalAlignment="Center" Foreground="#617188" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold"/>
                            <Border Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="5" Padding="2">
                                <ComboBox x:Name="cmbLanguage" Width="100" SelectedIndex="0" Height="28" VerticalAlignment="Center" FontSize="11" Foreground="#34465B" Background="Transparent" BorderThickness="0" SelectionChanged="cmbLanguage_SelectionChanged">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Hindi"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Separator Grid.Row="1" VerticalAlignment="Bottom" Background="#E7EDF3" Margin="26,0"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="26,18,26,24">
                        <StackPanel>
                            <TextBlock Text="Select one answer." FontSize="11" FontWeight="SemiBold" Foreground="#617188" Margin="0,0,0,14"/>
                            <TextBlock x:Name="txtQuestion" Text="Loading..." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#17283D" Margin="0,0,0,20" LineHeight="25"/>

                            <Border x:Name="borderQuestionImg" Background="#F7F9FC" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,20" HorizontalAlignment="Left" MaxHeight="300" Visibility="Collapsed">
                                <Image x:Name="imgQuestionPhoto" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left"/>
                            </Border>

                            <RadioButton x:Name="optA" GroupName="Answers" Style="{StaticResource AnswerOptionStyle}" Checked="Option_Checked" Tag="A">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="A" FontWeight="Bold" Foreground="#2457A7"/><TextBlock x:Name="txtOptA" Grid.Column="1" Text="Option A" TextWrapping="Wrap" Foreground="#263A50"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="optB" GroupName="Answers" Style="{StaticResource AnswerOptionStyle}" Checked="Option_Checked" Tag="B">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="B" FontWeight="Bold" Foreground="#2457A7"/><TextBlock x:Name="txtOptB" Grid.Column="1" Text="Option B" TextWrapping="Wrap" Foreground="#263A50"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="optC" GroupName="Answers" Style="{StaticResource AnswerOptionStyle}" Checked="Option_Checked" Tag="C">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="C" FontWeight="Bold" Foreground="#2457A7"/><TextBlock x:Name="txtOptC" Grid.Column="1" Text="Option C" TextWrapping="Wrap" Foreground="#263A50"/></Grid>
                            </RadioButton>
                            <RadioButton x:Name="optD" GroupName="Answers" Style="{StaticResource AnswerOptionStyle}" Checked="Option_Checked" Tag="D">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="D" FontWeight="Bold" Foreground="#2457A7"/><TextBlock x:Name="txtOptD" Grid.Column="1" Text="Option D" TextWrapping="Wrap" Foreground="#263A50"/></Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,0,13">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#EFF3F7" Width="54" Height="62" CornerRadius="5" BorderBrush="#D8E1EB" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                            <Image x:Name="imgCandidatePhoto" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblCandidateName" Text="Candidate" FontSize="14" FontWeight="SemiBold" Foreground="#17283D" TextWrapping="Wrap"/>
                            <TextBlock x:Name="lblRollExam" Text="Roll No" FontSize="11" Foreground="#617188" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,0,13">
                    <StackPanel>
                        <TextBlock Text="RESPONSE STATUS" FontSize="10" FontWeight="Bold" Foreground="#617188" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,10">
                                <Border Width="16" Height="16" CornerRadius="3" Background="#28825B"/><TextBlock Text="Answered" FontSize="10" FontWeight="SemiBold" Foreground="#34465B" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="16" Height="16" CornerRadius="3" Background="#B94A48"/><TextBlock Text="Not answered" FontSize="10" FontWeight="SemiBold" Foreground="#34465B" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                                <Border Width="16" Height="16" CornerRadius="3" Background="#F2F5F9" BorderBrush="#AAB7C5" BorderThickness="1"/><TextBlock Text="Not visited" FontSize="10" FontWeight="SemiBold" Foreground="#34465B" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Border Width="16" Height="16" CornerRadius="3" Background="#7252A3"/><TextBlock Text="For review" FontSize="10" FontWeight="SemiBold" Foreground="#34465B" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="7" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="2,0,2,12">
                            <TextBlock Text="QUESTION NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="#617188"/>
                            <TextBlock Text="Select a number to move to that question." FontSize="10" Foreground="#8492A2" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="wpPalette" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="0,1,0,0" Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnReview" Grid.Column="0" Content="Mark for review" Height="42" MinWidth="145" Margin="0,0,10,0" Background="#7252A3" Style="{StaticResource ActionButtonStyle}"/>
                <Button x:Name="btnClear" Grid.Column="1" Content="Clear response" Height="42" MinWidth="135" Background="#F1F4F8" Foreground="#34465B" BorderBrush="#D0DAE5" BorderThickness="1" Style="{StaticResource ActionButtonStyle}" Click="btnClear_Click"/>
                <Button x:Name="btnPrev" Grid.Column="3" Content="Previous" Height="42" MinWidth="112" Margin="0,0,10,0" Background="#EDF2F7" Foreground="#34465B" BorderBrush="#D0DAE5" BorderThickness="1" Style="{StaticResource ActionButtonStyle}" Click="btnPrev_Click"/>
                <Button x:Name="btnNext" Grid.Column="4" Content="Save &amp; Next" Height="42" MinWidth="135" Margin="0,0,10,0" Background="#2457A7" Style="{StaticResource ActionButtonStyle}" Click="btnNext_Click"/>
                <Button x:Name="btnSubmitExam" Grid.Column="5" Content="Submit exam" Height="42" MinWidth="135" Background="#A63E3B" Style="{StaticResource ActionButtonStyle}" Click="btnSubmitExam_Click"/>
            </Grid>
        </Border>

        <Grid x:Name="gridLoading" Grid.RowSpan="3" Background="#D914283F" Panel.ZIndex="100">
            <Border Background="#14283F" BorderBrush="#40566D" BorderThickness="1" CornerRadius="8" Padding="34,26" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="EXAM SESSION" FontSize="10" FontWeight="Bold" Foreground="#B8C6D5" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtLoadingMessage" Text="Connecting to the examination service..." FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
