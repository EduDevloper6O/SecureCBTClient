<Window x:Class="SecureCBTClient.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CBT System - Waiting Lobby" WindowState="Maximized" WindowStyle="None"
        Background="#E5E7EB" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="COMPUTER BASED TEST (CBT) - WAITING LOBBY" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="System: " Foreground="#94A3B8" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="SECURE-WORKSTATION" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.5*" />
                <ColumnDefinition Width="2.5*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: INSTRUCTIONS -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0" Padding="20,15">
                    <Grid>
                        <TextBlock x:Name="txtHeading" Text="General Instructions" FontSize="22" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="txtViewIn" Text="View In: " VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,5,0" FontSize="14"/>
                            <ComboBox x:Name="cmbLanguage" Width="120" SelectedIndex="0" Height="28" FontSize="14" VerticalAlignment="Center" SelectionChanged="cmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="English"/>
                                <ComboBoxItem Content="Hindi"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,1,0" Padding="20,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel TextBlock.FontSize="15" TextBlock.Foreground="#334155" TextBlock.LineHeight="26" Margin="0,0,15,0">
                            <TextBlock x:Name="txtInst0" Text="Please read the following instructions carefully before the exam begins:" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,15"/>
                            <TextBlock x:Name="txtInst1" Text="1. The examination will automatically start when the countdown timer reaches zero." TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtInst2" Text="2. Total duration of the examination is indicated on the top right of your screen." TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtInst3" Text="3. The countdown timer in the top right corner of screen will display the remaining time available." TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtInst4" Text="4. Do not close this window or switch applications. Doing so will trigger a violation." TextWrapping="Wrap" Foreground="#DC2626" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtInst5" Text="5. To answer a question, select an option and click the 'Save &amp; Next' button." TextWrapping="Wrap" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <CheckBox x:Name="chkAgree" Margin="0,0,0,15" Cursor="Hand" Click="chkAgree_Click">
                            <TextBlock x:Name="txtAgree" Text="I have read and understood the instructions. All computer hardware allotted to me is in proper working condition." TextWrapping="Wrap" FontSize="14" Foreground="#1E293B" FontWeight="SemiBold" LineHeight="20" Margin="5,-2,0,0"/>
                        </CheckBox>
                        <Button x:Name="btnStartExam" Content="I AM READY TO BEGIN" Height="45" Width="250" FontSize="15" 
                                FontWeight="Bold" Background="#94A3B8" Foreground="White" BorderThickness="0" 
                                Cursor="Hand" IsEnabled="False" Click="btnStartExam_Click" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT: CANDIDATE INFO & COUNTDOWN -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" Padding="20" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtProfileHeading" Text="Candidate Profile" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                        <Border Background="#E2E8F0" Width="100" Height="120" BorderThickness="1" BorderBrush="#CBD5E1" Margin="0,0,0,15">
                            <Image x:Name="imgCandidatePhoto" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="lblCandidateName" Text="Name: Loading..." FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblRollNumber" Text="Roll No: Loading..." FontSize="14" Foreground="#475569" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="lblExamCode" Text="Exam: Loading..." FontSize="14" Foreground="#475569" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#0F172A" Padding="30,40" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtTimerHeading" Text="EXAM STARTS IN" FontSize="16" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="lblTimer" Text="00:00:00" FontSize="52" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>