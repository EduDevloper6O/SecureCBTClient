<Window x:Class="SecureCBTClient.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure CBT - Exam Instructions" WindowState="Maximized" WindowStyle="None"
        Background="#F2F5F9" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="PremiumStartButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#AAB5C2"/>
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReactiveAgreeBox" TargetType="Border">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="BorderBrush" Value="#D8E1EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=chkAgree, Path=IsChecked}" Value="True">
                    <Setter Property="Background" Value="#F0F7F3"/>
                    <Setter Property="BorderBrush" Value="#9EC8AC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="#14283F" Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" Background="#FFFFFF" VerticalAlignment="Center">
                    <Image x:Name="imgAuthorityLogo" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" Margin="4"/>
                </Border>
                <StackPanel x:Name="HeaderTextPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="lblAuthorityName" Text="EXAMINATION AUTHORITY" Foreground="#D5DFE9" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="lblExamTitle" Text="EXAMINATION TITLE" Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#263B51" BorderBrush="#40546A" BorderThickness="1" CornerRadius="5" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#67B58A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="CANDIDATE SESSION" Foreground="#E8EEF4" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="0.95*" MinWidth="290"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="8" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E7EDF3" BorderThickness="0,0,0,1" Padding="26,20">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BEFORE YOU BEGIN" FontSize="10" FontWeight="Bold" Foreground="#617188" Margin="0,0,0,5"/>
                                <TextBlock x:Name="txtHeading" Text="General Instructions" FontSize="21" FontWeight="SemiBold" Foreground="#17283D"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Language" VerticalAlignment="Center" Foreground="#617188" Margin="0,0,9,0" FontSize="12" FontWeight="SemiBold"/>
                                <Border Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="5" Padding="3">
                                    <ComboBox x:Name="cmbLanguage" Width="105" SelectedIndex="0" Height="28" FontSize="12" Foreground="#34465B" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" SelectionChanged="cmbLanguage_SelectionChanged">
                                        <ComboBoxItem Content="English"/>
                                        <ComboBoxItem Content="Hindi"/>
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,20">
                        <StackPanel TextBlock.FontSize="14" TextBlock.Foreground="#34465B" TextBlock.LineHeight="23">
                            <TextBlock x:Name="txtInst0" Text="Please read the following instructions carefully before the exam begins:" FontSize="14" FontWeight="SemiBold" Foreground="#17283D" TextWrapping="Wrap" Margin="0,0,0,18"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#EAF0F7" VerticalAlignment="Top"><TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#2457A7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock x:Name="txtInst1" Grid.Column="1" Text="The examination start button becomes available when the scheduled countdown reaches zero." TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#EAF0F7" VerticalAlignment="Top"><TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#2457A7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock x:Name="txtInst2" Grid.Column="1" Text="Use the section tabs to move between the subjects in your examination." TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#EAF0F7" VerticalAlignment="Top"><TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#2457A7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock x:Name="txtInst3" Grid.Column="1" Text="The timer at the top of the exam screen displays the time remaining." TextWrapping="Wrap"/>
                            </Grid>
                            <Border Background="#FFF8E8" BorderBrush="#EBD49A" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#F7E7B6" VerticalAlignment="Top"><TextBlock Text="4" FontSize="11" FontWeight="Bold" Foreground="#805C0B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock x:Name="txtInst4" Grid.Column="1" Text="Keep the exam client open and do not switch applications while taking the examination." TextWrapping="Wrap" Foreground="#654D16" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#EAF0F7" VerticalAlignment="Top"><TextBlock Text="5" FontSize="11" FontWeight="Bold" Foreground="#2457A7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock x:Name="txtInst5" Grid.Column="1" Text="Select an answer option, then choose 'Save &amp; Next' to continue." TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E7EDF3" BorderThickness="0,1,0,0" Padding="22,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ReactiveAgreeBox}" Margin="0,0,18,0">
                                <CheckBox x:Name="chkAgree" Cursor="Hand" Click="chkAgree_Click" VerticalContentAlignment="Center">
                                    <TextBlock x:Name="txtAgree" Text="I have read and understood the instructions. All computer hardware allotted to me is in proper working condition." TextWrapping="Wrap" FontSize="12" Foreground="#34465B" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </CheckBox>
                            </Border>
                            <Button x:Name="btnStartExam" Grid.Column="1" Content="I AM READY TO BEGIN" Height="48" Width="225" Background="#AAB5C2" Style="{StaticResource PremiumStartButtonStyle}" IsEnabled="False" Click="btnStartExam_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="txtProfileHeading" Text="CANDIDATE PROFILE" FontSize="10" FontWeight="Bold" Foreground="#617188" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="70" Height="76" CornerRadius="5" Background="#EFF3F7" BorderBrush="#D8E1EB" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                                <Image x:Name="imgCandidatePhoto" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="lblCandidateName" Text="Loading candidate..." FontSize="15" FontWeight="SemiBold" Foreground="#17283D" TextWrapping="Wrap"/>
                                <TextBlock x:Name="lblRollNumber" Text="Roll No" FontSize="12" Foreground="#617188" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="TimerBorder" Grid.Row="1" Background="#14283F" CornerRadius="8" Padding="20,21" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="txtTimerHeading" Text="EXAM STARTS IN" FontSize="10" FontWeight="Bold" Foreground="#D5DFE9" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="lblTimer" Text="00:00:00" FontSize="42" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" FontFamily="Consolas"/>
                        <TextBlock Text="The start button becomes available when the scheduled time begins." FontSize="11" Foreground="#E0E7EF" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="8" Padding="18" VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SESSION CHECK" FontSize="10" FontWeight="Bold" Foreground="#617188" Margin="0,0,0,10"/>
                        <TextBlock Text="Confirm that your candidate details are correct and that you can continue with the examination." FontSize="13" Foreground="#34465B" TextWrapping="Wrap" LineHeight="21"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
