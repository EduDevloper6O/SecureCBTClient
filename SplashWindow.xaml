<Window x:Class="Elecctron.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elecctron" Width="560" Height="390" WindowStyle="None"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Loaded="Window_Loaded" FontFamily="Segoe UI">
    <Border CornerRadius="28" ClipToBounds="True">
        <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.24" Color="#15233F" /></Border.Effect>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#172644" Offset="0" />
                    <GradientStop Color="#2E477F" Offset="0.65" />
                    <GradientStop Color="#586DF4" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="310" Height="310" Fill="#14FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-110,0" />
            <Ellipse Width="240" Height="240" Fill="#10FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-130" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="20" Background="#30FFFFFF" HorizontalAlignment="Center">
                    <TextBlock Text="E" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ELECCTRON" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,17,0,0" />
                <TextBlock Text="CBT EXAM PRACTICE" Foreground="#C8D3F3" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0" />
                <Grid Width="46" Height="46" Margin="0,27,0,0">
                    <Ellipse Stroke="#55FFFFFF" StrokeThickness="4" />
                    <Ellipse Width="10" Height="10" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Ellipse.RenderTransform><RotateTransform x:Name="SpinnerRotation" CenterX="23" CenterY="23" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>
                <TextBlock Text="Preparing your exam workspace" Foreground="#E0E7FA" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0" />
                <ProgressBar Width="180" Height="3" IsIndeterminate="True" BorderThickness="0" Background="#33FFFFFF" Foreground="White" Margin="0,15,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
