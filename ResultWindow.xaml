<Window x:Class="SecureCBTClient.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Result" WindowState="Maximized" WindowStyle="None"
        Background="#F1F5F9" FontFamily="Segoe UI">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="12" Padding="40" BorderBrush="#E2E8F0" BorderThickness="1" Width="480">
            <StackPanel HorizontalAlignment="Center">
                <Border Background="#ECFDF5" Width="70" Height="70" CornerRadius="35" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="🎉" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Exam Submitted Successfully!" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                <TextBlock Text="Here is your official examination summary" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,5,0,25"/>

                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Attempted:" FontSize="15" Margin="0,5" Foreground="#334155"/>
                    <TextBlock x:Name="lblAttempted" Grid.Row="0" Grid.Column="1" Text="--" FontWeight="Bold" FontSize="15" Margin="0,5" Foreground="#0F172A"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Correct Answers:" FontSize="15" Margin="0,5" Foreground="#334155"/>
                    <TextBlock x:Name="lblCorrect" Grid.Row="1" Grid.Column="1" Text="--" FontWeight="Bold" FontSize="15" Margin="0,5" Foreground="#10B981"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Incorrect Answers:" FontSize="15" Margin="0,5" Foreground="#334155"/>
                    <TextBlock x:Name="lblWrong" Grid.Row="2" Grid.Column="1" Text="--" FontWeight="Bold" FontSize="15" Margin="0,5" Foreground="#EF4444"/>

                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10"/>
                </Grid>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Final Score: " FontSize="18" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBlock x:Name="lblScore" Text="--" FontSize="22" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <Button Content="Exit Examination" Height="42" Width="180" Background="#1E293B" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="btnExit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>