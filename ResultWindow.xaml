<Window x:Class="SecureCBTClient.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Submission Summary" WindowState="Maximized" WindowStyle="None"
        Background="#F2F5F9" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="PremiumExitButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="5" Background="{TemplateBinding Background}" Padding="18,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContainer" Background="#F2F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#14283F" Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SECURE CBT CLIENT" FontSize="10" FontWeight="Bold" Foreground="#B8C6D5"/>
                    <TextBlock Text="Examination summary" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="SESSION COMPLETE" FontSize="10" FontWeight="Bold" Foreground="#E5ECF3" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Border x:Name="ResultCard" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="8" Width="700" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="38">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Color="#152B43" Opacity="0.12"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#EAF3ED" Margin="0,0,9,0">
                            <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="#28734D" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SUBMISSION RECEIVED" FontSize="10" FontWeight="Bold" Foreground="#28734D" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,26">
                        <TextBlock Text="Examination submitted" FontSize="25" FontWeight="SemiBold" Foreground="#17283D" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Your response summary is shown below." FontSize="13" Foreground="#617188" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,7,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F5F7FA" BorderBrush="#E1E7EE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ATTEMPTED" FontSize="9" FontWeight="Bold" Foreground="#617188" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblAttempted" Text="--" FontSize="25" FontWeight="SemiBold" Foreground="#263A50" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#F1F7F3" BorderBrush="#D6E8DC" BorderThickness="1" CornerRadius="6" Padding="14" Margin="4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="CORRECT" FontSize="9" FontWeight="Bold" Foreground="#28734D" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblCorrect" Text="--" FontSize="25" FontWeight="SemiBold" Foreground="#28734D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FBF2F1" BorderBrush="#EEDDDC" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="INCORRECT" FontSize="9" FontWeight="Bold" Foreground="#A63E3B" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                <TextBlock x:Name="lblWrong" Text="--" FontSize="25" FontWeight="SemiBold" Foreground="#A63E3B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Background="#F7F9FC" BorderBrush="#D8E1EB" BorderThickness="1" CornerRadius="6" Padding="18,15" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL SCORE" FontSize="9" FontWeight="Bold" Foreground="#617188"/>
                                <TextBlock Text="Final result" FontSize="13" FontWeight="SemiBold" Foreground="#263A50" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="lblScore" Grid.Column="1" Text="--" FontSize="30" FontWeight="SemiBold" Foreground="#2457A7" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button x:Name="btnExit" Grid.Row="4" Content="Exit examination client" Height="46" Width="240" HorizontalAlignment="Center" Background="#14283F" Style="{StaticResource PremiumExitButtonStyle}" Click="btnExit_Click"/>

                    <Grid x:Name="OverlayLoading" Grid.RowSpan="5" Background="#F2FFFFFF" Visibility="Collapsed" Panel.ZIndex="10">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="190" Height="5" IsIndeterminate="True" Foreground="#2457A7" Margin="0,0,0,14"/>
                            <TextBlock Text="Loading your response summary..." FontSize="13" FontWeight="SemiBold" Foreground="#17283D" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
